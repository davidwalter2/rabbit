{
  "providers": {
    "cern": {
      "name": "CERN AI Gateway",
      "baseUrl": "https://aigw.cern.ch/v1",
      "api": "openai-completions",
      "models": [
        {
          "id": "Kimi-K3-FLATIRON",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 1048570,
          "maxTokens": 131072,
          "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
          "compat": {
            "supportsStore": false,
            "supportsDeveloperRole": false,
            "supportsReasoningEffort": true,
            "thinkingFormat": "openai",
            "maxTokensField": "max_completion_tokens"
          },
          "thinkingLevelMap": {
            "minimal": "low",
            "low": "low",
            "medium": "high",
            "high": "high",
            "xhigh": "max",
            "max": "max"
          }
        }
      ]
    }
  }
}
